<?xml version="1.0" encoding="utf-8"?>
<!--
  axiom-office-mcp: MCP server stdio cho Linux (va Windows), khong can cai them gi.
  Dung CHUNG ma nguon tool voi AxiomOffice.Host (net48) - compile lai src\AxiomOffice.Host\Mcp\*.cs
  voi ky hieu PORTABLE; phan chi Windows (COM .xls, HKCU) nam trong #if PORTABLE / lop shim Compat.

  dotnet publish src/AxiomOffice.Mcp -c Release -r linux-x64 (self-contained)
  Script dong goi: scripts/linux/package.sh
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>axiom-office-mcp</AssemblyName>
    <RootNamespace>AxiomOffice.Mcp</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
    <Product>Axiom Office MCP server</Product>
    <!-- Ban .NET 10 cua ma nguon dung chung: doi JavaScriptSerializer -> shim, COM .xls -> LibreOffice. -->
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
    <Compile Include="..\AxiomOffice.Host\Mcp\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ten resource giu nguyen nhu ban Windows (McpHost.Templates doc theo ten nay). -->
    <EmbeddedResource Include="..\AxiomOffice.Host\Mcp\Templates\default.docx" LogicalName="AxiomOffice.Mcp.default.docx" />
    <EmbeddedResource Include="..\AxiomOffice.Host\Mcp\Templates\default.pptx" LogicalName="AxiomOffice.Mcp.default.pptx" />
    <EmbeddedResource Include="live-commands.json" LogicalName="AxiomOffice.Mcp.live-commands.json" />
  </ItemGroup>

</Project>
