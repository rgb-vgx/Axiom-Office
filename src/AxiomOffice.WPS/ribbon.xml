<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ribbon cua add-in WPS (docs/ribbon-ui.md muc 2): cung mot tab, cung nhom, cung nhan voi ban Windows
  (src/AxiomOffice/Ribbon/RibbonUi.cs, const RibbonXml) - nguoi dung doi may khong phai hoc lai.

  Bon nguyen tac cua docs/ribbon-ui.md muc 1 duoc giu o day:
   - Mot tab duy nhat "Axiom Office"; khong mo tab thu hai.
   - Khong ve control gia: moi nut deu co duong that dung sau (lenh bridge da co, hoac route /wps/v1/*
     ma pane goi duoc). Bon thu cua ban Windows CO Y KHONG ve o day, xem chu thich ngay duoi.
   - getVisible chi de DON DEP (an nut khong dung cho app dang mo). WPS co the bo qua callback nay,
     nen nut van phai tu noi duoc ly do khi bam sai app - do la viec cua tag + OnAction trong main.js,
     khong phai cua getVisible.

  Icon (giong ban Windows: moi nut deu co icon):
   - Nut tren RIBBON dung imageMso = bo icon co san cua chinh WPS (do tren WPS 12.1.2 that 20/10/2026: hien
     dung icon). WPS tra ten kieu Office qua bang lenh cua no - /opt/kingsoft/wps-office/office6/res/commands/
     <wps|et|wpp>/ongmani/*.kuip, moi lenh co idMso="..." va icon="..._kd". CHI dung ten co trong bang do: ten
     khong co thi WPS khong ve icon. Ten nao chi co o mot app (SlideShowFromCurrent: trinh chieu,
     TableInsertDialogWord: van ban, DataValidation: bang tinh) thi chi dung cho nut cua dung app do (ba nut
     Soat); nut dung chung ca ba app phai la ten co o CA BA bang. Bang ten + ly do: docs/ribbon-ui.md muc 5.3;
     spec tests/wps/test_pane.mjs ghim.
   - Menu CHUOT PHAI van dung getImage="ribbon.OnGetImage" -> main.js tra DUONG DAN TUONG DOI "images/<tag>.svg"
     (askAi.svg, quickMenu.svg) - imageMso trong menu ngu canh chua thu. WPS KHONG nhan data URI cho getImage: no
     phan giai chuoi tra ve nhu mot duong dan, truot thi ve dau "?" (SDK: @wps-jsapi/wps/js/ribbon.js).

  Menu chuot phai (<contextMenus> cuoi tep): "Sua bang AI >" 9 muc + "Hoi AI ve doan nay", tren chu thuong va tren
  dong danh sach. Bam mot muc thi mo KHUNG CHAT MINI canh doan boi den (mini.html, Application.ShowDialog); ban WPS
  khong co ShowDialog thi quay ve khung chat lon (main.js: openMini / runQuick).
  Ban Windows chi co "Hoi AI ve doan nay" va chi dua contextMenus cho Office (RibbonUi.cs: "WPS khong nhan chac").
  WPS Linux THI NHAN: menu da hien va chay tren WPS that 20/10/2026 (docs/ribbon-ui.md muc 5.3).

  Vi sao thieu bon control so voi ban Windows (xem docs/ribbon-ui.md muc 5):
   - toggleButton "Nhin tai lieu" (visualQa): lenh app.screenshot ma Core gui qua bridge CHUA co handler
     trong add-in WPS, nen bat toggle len la moi luot chay agent se hong o buoc "nhin tai lieu".
   - dropDown "Tim web": chon nguon tim kiem ghi ca vao mcp.json (SearchSources.Activate), ma kenh
     /wps/v1/* khong co route ghi mcp.json - ve ra thi nut khong lam duoc gi.
   - button "Cong cu ngoai..." (MCP): GET /v1/mcp khong nam tren kenh /wps/v1/*, va cung khong co route ghi.
   - button "Cai dat nang cao...": man hinh Thiet lap cua pane da chua DAY DU cac truong cau hinh
     (endpoint, model, khoa, cac cong tac) - them mot nut mo dung man hinh do la nut gia.
   - button "Tat Agent Core...": route POST /v1/admin/shutdown khong co tren kenh /wps/v1/*, va Core
     chinh la thu dang phuc vu pane - tat no la lam pane chet ngay truoc mat nguoi dung.
   - menu ngon ngu: WPS khong co tep lang/*.json (scripts/check_i18n.py chi quet ban C#), nhan o day la
     tieng Viet co dinh.
-->
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="ribbon.OnAddinLoad">
  <ribbon>
    <tabs>
      <tab id="axiomTab" label="Axiom Office">

        <group id="axiomAssistantGroup" label="Trợ lý">
          <button id="axiomAskAI" label="Ask AI" size="large" tag="askAi" onAction="ribbon.OnAction" imageMso="Help"
                  screentip="Ask AI"
                  supertip="Mở khung trò chuyện với AI bên cạnh tài liệu."/>
        </group>

        <!-- Ba nut soat chi doc, moi nut mot app (giong ban Windows: tag ung voi kieu app trong
             OnGetVisible). WPS bo qua getVisible thi ca ba deu hien, va bam sai app se duoc add-in
             tra loi ro "lenh nay can ung dung kia" - xem commands.js: execute() kiem catalogEntry.kind. -->
        <group id="axiomCheckGroup" label="Kiểm tra">
          <button id="axiomCheckLayout" label="Soát bố cục" size="large" tag="checkLayout"
                  getVisible="ribbon.OnGetVisible" onAction="ribbon.OnAction" imageMso="SlideShowFromCurrent"
                  screentip="Soát bố cục"
                  supertip="Tìm chữ tràn khung, khung ra ngoài slide, khung chồng nhau, chữ quá nhỏ. Chỉ đọc, không dùng AI."/>
          <button id="axiomCheckTables" label="Soát bảng" size="large" tag="checkTables"
                  getVisible="ribbon.OnGetVisible" onAction="ribbon.OnAction" imageMso="TableInsertDialogWord"
                  screentip="Soát bảng"
                  supertip="Tìm ô trống và ô tiêu đề lẫn đoạn văn trong các bảng. Chỉ đọc, không dùng AI."/>
          <button id="axiomCheckRange" label="Soát vùng dữ liệu" size="large" tag="checkRange"
                  getVisible="ribbon.OnGetVisible" onAction="ribbon.OnAction" imageMso="DataValidation"
                  screentip="Soát vùng dữ liệu"
                  supertip="Tìm cột thiếu tiêu đề, số lưu dạng chữ, ô lỗi, dữ liệu lạc ngoài bảng. Chỉ đọc, không dùng AI."/>
        </group>

        <group id="axiomManageGroup" label="Quản lý">
          <button id="axiomMemory" label="Bộ nhớ AI…" size="large" tag="memory" onAction="ribbon.OnAction" imageMso="FileSave"
                  screentip="Bộ nhớ AI"
                  supertip="Xem, lọc theo phạm vi, xoá tạm, khôi phục, xoá vĩnh viễn những điều AI đã ghi nhớ về bạn và tài liệu."/>
          <button id="axiomSkills" label="Kỹ năng…" size="large" tag="skills" onAction="ribbon.OnAction" imageMso="JsAddInsDialog"
                  screentip="Kỹ năng"
                  supertip="Các kỹ năng AI đang có cho ứng dụng này; nạp lại sau khi thêm hoặc sửa kỹ năng."/>
        </group>

        <group id="axiomSystemGroup" label="Hệ thống">
          <button id="axiomSetup" label="Thiết lập…" size="large" tag="setup" onAction="ribbon.OnAction" imageMso="ApplicationOptionsDialog"
                  screentip="Thiết lập"
                  supertip="Máy chủ AI, model, khoá API và các công tắc của Agent Core. Lưu xong có hiệu lực ngay."/>
          <button id="axiomStatus" label="Trạng thái" tag="status" onAction="ribbon.OnAction" imageMso="About"
                  screentip="Trạng thái"
                  supertip="Kiểm tra thật: add-in có trả lời không, Agent Core có chạy không, model đang dùng."/>
          <button id="axiomLog" label="Mở nhật ký" tag="openLog" onAction="ribbon.OnAction" imageMso="FileOpen"
                  screentip="Mở nhật ký"
                  supertip="Xem phần cuối nhật ký của Agent Core (cùng tệp mà bản Windows mở bằng trình soạn thảo)."/>
          <menu id="axiomMoreMenu" label="Khác" tag="more" imageMso="FileProperties">
            <button id="axiomTestModel" label="Kiểm tra mô hình" tag="testModel" onAction="ribbon.OnAction" imageMso="ReviewNewComment"
                    screentip="Kiểm tra mô hình"
                    supertip="Gửi một câu hỏi ngắn tới model đang cấu hình để xem có trả lời được không."/>
            <button id="axiomCopyUrl" label="Sao chép API URL" tag="copyUrl" onAction="ribbon.OnAction" imageMso="Copy"
                    screentip="Sao chép API URL"
                    supertip="Địa chỉ bridge của add-in kèm /health - dán vào trình duyệt để tự kiểm tra add-in còn trả lời không. API của Agent Core đòi token nên không dán thẳng vào trình duyệt được."/>
          </menu>
        </group>

      </tab>
    </tabs>
  </ribbon>
  <!-- Menu chuot phai khi boi den (docs/ribbon-ui.md, "Trong khung chat"): 9 muc "Sua bang AI", cung thu tu va
       nhan voi bang cua Core (agent/quickactions.go) - spec test_pane.mjs ghim hai ben. Bam mot muc: main.js mo
       KHUNG CHAT MINI (mini.html, Application.ShowDialog) va muc do chay ngay trong khung ay. Du phong khi WPS
       khong co ShowDialog: hien khung chat lon roi nho Core chuyen muc (POST /wps/v1/pane/request -> SSE
       /wps/v1/pane/events), muc chay trong hoi thoai cua khung chat lon.
       ContextMenuText = chuot phai tren chu thuong, ContextMenuList = tren dong danh sach (ten idMso co trong bang
       lenh cua Writer WPS: res/commands/wps). -->
  <contextMenus>
    <contextMenu idMso="ContextMenuText">
      <menu id="axiomCtxQuick_t" label="Sửa bằng AI" tag="quickMenu" getImage="ribbon.OnGetImage" insertBeforeMso="Cut">
        <button id="axiomQuick_polish_t" label="Trau chuốt" tag="quick:polish" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_rewrite_t" label="Viết lại" tag="quick:rewrite" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_shorten_t" label="Rút gọn" tag="quick:shorten" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_expand_t" label="Mở rộng" tag="quick:expand" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_fix_t" label="Sửa lỗi chính tả" tag="quick:fix" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_formal_t" label="Trang trọng hơn" tag="quick:formal" onAction="ribbon.OnAction"/>
        <menuSeparator id="axiomCtxQuickSep_t"/>
        <button id="axiomQuick_summarize_t" label="Tóm tắt" tag="quick:summarize" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_explain_t" label="Giải thích" tag="quick:explain" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_translate_t" label="Dịch" tag="quick:translate" onAction="ribbon.OnAction"/>
      </menu>
      <button id="axiomCtxAsk_t" label="Hỏi AI về đoạn này" tag="askAi" onAction="ribbon.OnAction" getImage="ribbon.OnGetImage" insertBeforeMso="Cut"/>
    </contextMenu>
    <contextMenu idMso="ContextMenuList">
      <menu id="axiomCtxQuick_l" label="Sửa bằng AI" tag="quickMenu" getImage="ribbon.OnGetImage" insertBeforeMso="Cut">
        <button id="axiomQuick_polish_l" label="Trau chuốt" tag="quick:polish" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_rewrite_l" label="Viết lại" tag="quick:rewrite" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_shorten_l" label="Rút gọn" tag="quick:shorten" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_expand_l" label="Mở rộng" tag="quick:expand" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_fix_l" label="Sửa lỗi chính tả" tag="quick:fix" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_formal_l" label="Trang trọng hơn" tag="quick:formal" onAction="ribbon.OnAction"/>
        <menuSeparator id="axiomCtxQuickSep_l"/>
        <button id="axiomQuick_summarize_l" label="Tóm tắt" tag="quick:summarize" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_explain_l" label="Giải thích" tag="quick:explain" onAction="ribbon.OnAction"/>
        <button id="axiomQuick_translate_l" label="Dịch" tag="quick:translate" onAction="ribbon.OnAction"/>
      </menu>
      <button id="axiomCtxAsk_l" label="Hỏi AI về đoạn này" tag="askAi" onAction="ribbon.OnAction" getImage="ribbon.OnGetImage" insertBeforeMso="Cut"/>
    </contextMenu>
  </contextMenus>
</customUI>
