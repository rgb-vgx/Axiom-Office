<?xml version="1.0" encoding="UTF-8"?>
<!-- Dang ky factory tao panel cho sidebar (LibreOffice_arch.md muc 10). Sidebar tim factory theo
     ImplementationURL trong Sidebar.xcu: private:resource/toolpanel/<Name>/<PanelId>, roi tao
     implementation org.axiomoffice.bridge.PanelFactory (xem python/axiom_panel.py). -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Factories" oor:package="org.openoffice.Office.UI">
  <node oor:name="Registered">
    <node oor:name="UIElementFactories">
      <node oor:name="AxiomOfficePanelFactory" oor:op="replace">
        <prop oor:name="Type">
          <value>toolpanel</value>
        </prop>
        <prop oor:name="Name">
          <value>AxiomOfficePanelFactory</value>
        </prop>
        <prop oor:name="Module">
          <value/>
        </prop>
        <prop oor:name="FactoryImplementation">
          <value>org.axiomoffice.bridge.PanelFactory</value>
        </prop>
      </node>
    </node>
  </node>
</oor:component-data>
