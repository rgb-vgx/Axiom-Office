<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu "Axiom Office" trong menubar cua Writer/Calc/Impress (LibreOffice_arch.md muc 10): Hoi AI (pane),
     Soat tai lieu, Thiet lap, Cai dat nang cao. URL org.axiomoffice.bridge:* duoc xu ly boi
     ProtocolHandler.xcu -> axiom/dispatch.py, va MOI URL o day phai co ten tuong ung trong ACTIONS cua
     dispatch.py (khong thi bam vao khong lam gi) - tests/lo/test_dispatch.py giu hai ben khop nhau. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBar">
      <node oor:name="org.axiomoffice.bridge.menu" oor:op="replace">
        <prop oor:name="Title">
          <value xml:lang="en-US">Axiom Office</value>
          <value xml:lang="vi">Axiom Office</value>
        </prop>
        <prop oor:name="Target">
          <value>_self</value>
        </prop>
        <node oor:name="Submenu">
          <node oor:name="askai" oor:op="replace">
            <prop oor:name="URL">
              <value>org.axiomoffice.bridge:askpane</value>
            </prop>
            <prop oor:name="Title">
              <value xml:lang="en-US">Ask AI</value>
              <value xml:lang="vi">Hỏi AI</value>
            </prop>
          </node>
          <node oor:name="check" oor:op="replace">
            <prop oor:name="URL">
              <value>org.axiomoffice.bridge:check</value>
            </prop>
            <prop oor:name="Title">
              <value xml:lang="en-US">Check document…</value>
              <value xml:lang="vi">Soát tài liệu…</value>
            </prop>
          </node>
          <node oor:name="setup" oor:op="replace">
            <prop oor:name="URL">
              <value>org.axiomoffice.bridge:setup</value>
            </prop>
            <prop oor:name="Title">
              <value xml:lang="en-US">Set up…</value>
              <value xml:lang="vi">Thiết lập…</value>
            </prop>
          </node>
          <node oor:name="settings" oor:op="replace">
            <prop oor:name="URL">
              <value>org.axiomoffice.bridge:settings</value>
            </prop>
            <prop oor:name="Title">
              <value xml:lang="en-US">Advanced settings…</value>
              <value xml:lang="vi">Cài đặt nâng cao…</value>
            </prop>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
