<?xml version="1.0" encoding="UTF-8"?>
<!-- Xu ly URL org.axiomoffice.bridge:... (menu trong Addons.xcu tro toi day).
     Ten node trong HandlerSet la implementation name cua component handler
     (python/axiom_dispatch.py), khong phai ten giao thuc. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="ProtocolHandler" oor:package="org.openoffice.Office">
  <node oor:name="HandlerSet">
    <node oor:name="org.axiomoffice.bridge.Dispatch" oor:op="replace">
      <prop oor:name="Protocols" oor:type="oor:string-list">
        <value>org.axiomoffice.bridge:*</value>
      </prop>
    </node>
  </node>
</oor:component-data>
