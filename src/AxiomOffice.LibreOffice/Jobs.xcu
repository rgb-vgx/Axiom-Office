<?xml version="1.0" encoding="UTF-8"?>
<!-- Khoi dong bridge khi LibreOffice mo (LibreOffice_arch.md muc 5.2). OnStartApp chay ca khi headless;
     onFirstVisibleTask la du phong neu OnStartApp bi bo qua. Job tu bo qua neu bridge da chay. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Jobs" oor:package="org.openoffice.Office">
  <node oor:name="Jobs">
    <node oor:name="AxiomOfficeBridge" oor:op="replace">
      <prop oor:name="Service">
        <value>org.axiomoffice.bridge.StartJob</value>
      </prop>
    </node>
  </node>
  <node oor:name="Events">
    <node oor:name="OnStartApp" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="AxiomOfficeBridge" oor:op="replace"/>
      </node>
    </node>
    <node oor:name="onFirstVisibleTask" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="AxiomOfficeBridge" oor:op="replace"/>
      </node>
    </node>
  </node>
</oor:component-data>
