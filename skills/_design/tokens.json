{
  "about": "Design tokens dùng chung cho Word / Excel / PowerPoint (New_arch.md mục 8.4.6). Đổi theo tổ chức bằng cách đặt thư mục _design khác trong SkillDirs hoặc %LOCALAPPDATA%\\AxiomOffice\\skills.",
  "fonts": {
    "ui": "Calibri",
    "document": "Times New Roman",
    "headingSans": "Calibri"
  },
  "colors": {
    "primary": "#1F4E79",
    "accent": "#2E75B6",
    "success": "#548235",
    "warning": "#C55A11",
    "danger": "#C00000",
    "text": "#262626",
    "muted": "#595959",
    "onPrimary": "#FFFFFF",
    "surface": "#F2F2F2",
    "band": "#DEEAF6",
    "border": "#8EAADB"
  },
  "slide": {
    "note": "Đơn vị point. Kích thước slide thật đọc từ wpp.checkLayout (slideWidth/slideHeight); 16:9 thường là 960x540.",
    "margin": 40,
    "gutter": 20,
    "type": { "title": 36, "subtitle": 24, "body": 20, "caption": 14, "minimum": 12 },
    "maxBulletsPerSlide": 5,
    "maxWordsPerBullet": 12
  },
  "document": {
    "type": { "title": 16, "heading1": 14, "heading2": 13, "body": 13, "table": 12, "note": 11 },
    "tableStyle": "Grid Table 4 - Accent 1",
    "plainTableStyle": "Table Grid"
  },
  "spreadsheet": {
    "type": { "title": 14, "header": 11, "body": 11 },
    "header": { "fillColor": "#1F4E79", "fontColor": "#FFFFFF", "bold": true, "horizontal": "center" },
    "totalRow": { "fillColor": "#DEEAF6", "bold": true },
    "numberFormats": {
      "integer": "#,##0",
      "decimal": "#,##0.00",
      "score": "0.0",
      "percent": "0.0%",
      "vnd": "#,##0 \"đ\"",
      "date": "dd/mm/yyyy"
    }
  }
}
